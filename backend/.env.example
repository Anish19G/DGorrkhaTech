# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://dgorkhatech:dgorkhatech@localhost:5433/dgorkhatech?schema=public"

# Server
PORT=4000
NODE_ENV=development

# CORS - the frontend origin allowed to call this API
FRONTEND_ORIGIN="http://localhost:3000"

# Auth
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Used only by prisma/seed.ts to create the first admin user
SEED_ADMIN_EMAIL="admin@dgorkhatech.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
